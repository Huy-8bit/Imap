COMPOSE_PROJECT_NAME=imap-local

APP_ENV=local
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

POSTGRES_DB=imap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432

REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379

BACKEND_HOST_BIND=127.0.0.1
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=3000

FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=8080
VITE_API_BASE_URL=http://127.0.0.1:8010
VITE_GOOGLE_CLIENT_ID=

JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
SETUP_ADMIN_SECRET=my-setup-secret-change-me
BOOTSTRAP_WAIT_TIMEOUT_SECONDS=120
BOOTSTRAP_SEED_TAXONOMIES=true
BOOTSTRAP_IMPORT_ORGANIZATIONS=true
ORGANIZATION_DATASET_PATH=docs/iMapVN/Data/Sample-iMap-Json/dataEng.json
