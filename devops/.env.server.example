COMPOSE_PROJECT_NAME=imap

APP_ENV=production

POSTGRES_DB=imap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5433

REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379

BACKEND_HOST_BIND=127.0.0.1
BACKEND_HOST_PORT=8010

FRONTEND_HOST_BIND=0.0.0.0
FRONTEND_HOST_PORT=80

CORS_ORIGINS=http://103.1.236.121
VITE_API_BASE_URL=http://103.1.236.121

JWT_SECRET=change-this-jwt-secret
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
BOOTSTRAP_WAIT_TIMEOUT_SECONDS=120
BOOTSTRAP_SEED_TAXONOMIES=true
BOOTSTRAP_IMPORT_ORGANIZATIONS=true
ORGANIZATION_DATASET_PATH=docs/iMapVN/Data/Sample-iMap-Json/dataEng.json
